{
	"name" : "luyadev/luya-mailjet",
	"type" : "luya-extension",
	"keywords" : [
		"luya", "mailjet", "yii2", "yii"
	],
	"license" : "MIT",
	"authors" : [
		{
			"name" : "Basil Suter",
			"email" : "basil@nadar.io"
		}
	],
	"require": {
		"luyadev/luya-core" : ">=1.0.25",
		"mailjet/mailjet-apiv3-php": "^1.6.7",
		"symfony/http-client": "^4.4 || ^5.4 || ^6.0 || ^7.0 || ^8.0"
	},
	"require-dev" : {
		"luyadev/luya-testsuite" : "^3.1",
		"luyadev/luya-module-admin" : "^5.0",
		"vlucas/phpdotenv": "^2.5"
	},
	"autoload" : {
		"psr-4" : {
			"luya\\mailjet\\" : "src/"
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"luya\\mailjet\\tests\\" : "tests/"
		}
	},
	"config": {
        "fxp-asset": {
            "enabled": false
        },
        "allow-plugins": {
            "luyadev/luya-composer": true,
            "yiisoft/yii2-composer": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
